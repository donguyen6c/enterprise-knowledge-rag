  <diagram id="core-schema" name="UML Core Schema">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="user" value="&lt;div style='font-weight:bold;text-align:center;font-size:16px'&gt;User&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- id: UUID (PK)&lt;br&gt;- email: string (UQ)&lt;br&gt;- username: string (UQ)&lt;br&gt;- password_hash: string&lt;br&gt;- first_name: string&lt;br&gt;- last_name: string&lt;br&gt;- avatar_url: string&lt;br&gt;- is_active: boolean&lt;br&gt;- is_verified: boolean&lt;br&gt;- last_login: timestamp&lt;br&gt;- created_at: timestamp&lt;br&gt;- updated_at: timestamp&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ login(password): bool&lt;br&gt;+ verify_email(): void&lt;br&gt;+ update_profile(): void&lt;/div&gt;" style="shape=swimlane;html=1;rounded=1;whiteSpace=wrap;container=1;collapsible=0;horizontal=1;fillColor=#DDEBF7;swimlaneFillColor=#DDEBF7;strokeColor=#5B9BD5;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="300" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="org" value="&lt;div style='font-weight:bold;text-align:center;font-size:16px'&gt;Organization&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- id: UUID (PK)&lt;br&gt;- name: string (UQ)&lt;br&gt;- slug: string (UQ)&lt;br&gt;- description: text&lt;br&gt;- logo_url: string&lt;br&gt;- is_active: boolean&lt;br&gt;- created_by: UUID (FK)&lt;br&gt;- created_at: timestamp&lt;br&gt;- updated_at: timestamp&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ add_member(user): void&lt;br&gt;+ remove_member(user): void&lt;/div&gt;" style="shape=swimlane;html=1;rounded=1;whiteSpace=wrap;container=1;collapsible=0;horizontal=1;fillColor=#D9EAD3;swimlaneFillColor=#D9EAD3;strokeColor=#70AD47;fontColor=#27632A;" vertex="1" parent="1">
          <mxGeometry x="410" y="100" width="320" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="role" value="&lt;div style='font-weight:bold;text-align:center;font-size:16px'&gt;Role&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- id: UUID (PK)&lt;br&gt;- name: string (UQ)&lt;br&gt;- description: text&lt;br&gt;- org_id: UUID (FK)&lt;br&gt;- is_default: boolean&lt;br&gt;- created_at: timestamp&lt;br&gt;- updated_at: timestamp&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ assign_permission(): void&lt;/div&gt;" style="shape=swimlane;html=1;rounded=1;whiteSpace=wrap;container=1;collapsible=0;horizontal=1;fillColor=#FCE4D6;swimlaneFillColor=#FCE4D6;strokeColor=#ED7D31;fontColor=#7F4E12;" vertex="1" parent="1">
          <mxGeometry x="810" y="100" width="290" height="330" as="geometry"/>
