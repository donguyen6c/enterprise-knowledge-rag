        <mxCell id="permission" value="&lt;div style='font-weight:bold;text-align:center;font-size:16px'&gt;Permission&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- id: UUID (PK)&lt;br&gt;- name: string (UQ)&lt;br&gt;- description: text&lt;br&gt;- resource: string&lt;br&gt;- action: string&lt;br&gt;- created_at: timestamp&lt;br&gt;- updated_at: timestamp&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ check_permission(): bool&lt;/div&gt;" style="shape=swimlane;html=1;rounded=1;whiteSpace=wrap;container=1;collapsible=0;horizontal=1;fillColor=#F4CCCC;swimlaneFillColor=#F4CCCC;strokeColor=#C55A7D;fontColor=#8B2F52;" vertex="1" parent="1">
          <mxGeometry x="1180" y="100" width="300" height="330" as="geometry"/>
