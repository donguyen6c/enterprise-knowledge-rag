        <mxCell id="document" value="&lt;div style='font-weight:bold;text-align:center;font-size:16px'&gt;Document&lt;/div&gt;&lt;hr&gt;&lt;div&gt;- id: UUID (PK)&lt;br&gt;- title: string&lt;br&gt;- content: text&lt;br&gt;- org_id: UUID (FK)&lt;br&gt;- created_by: UUID (FK)&lt;br&gt;- file_url: string&lt;br&gt;- file_type: string&lt;br&gt;- file_size: integer&lt;br&gt;- version: integer&lt;br&gt;- is_archived: boolean&lt;br&gt;- created_at: timestamp&lt;br&gt;- updated_at: timestamp&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ upload(): void&lt;br&gt;+ archive(): void&lt;/div&gt;" style="shape=swimlane;html=1;rounded=1;whiteSpace=wrap;container=1;collapsible=0;horizontal=1;fillColor=#E2F0D9;swimlaneFillColor=#E2F0D9;strokeColor=#70AD47;fontColor=#386641;" vertex="1" parent="1">
